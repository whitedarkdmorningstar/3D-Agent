{
  "expo": {
    "name": "3D-Agent",
    "slug": "3D-Agent",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "3dagent",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f9fafb",
        "foregroundImage": "./assets/light-icon.png"
      },
      "package": "com.three_d_agent.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f9fafb",
          "image": "./assets/light-icon.png",
          "width": 128,
          "dark": {
            "backgroundColor": "#090e1c",
            "image": "./assets/dark-icon.png",
            "width": 128
          }
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "259873cd-ad5a-4758-9c59-3db56abf541e"
      }
    }
  }
}
